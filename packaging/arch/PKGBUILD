# Maintainer: shahab <local>
# ParallelType Desktop - offline Tauri build of monkeytype (desktop fork 0.5.0)
#
# STATUS: validated inside WSL2 Arch (makepkg -f, binary run verified).
# GUI visual check via WSLg pending a screen-unlock (session was locked).
# Distribution still pending the GPL review (B7).

pkgname=paralleltype-desktop
pkgver=0.7.0
pkgrel=1
pkgdesc="A minimalistic, customizable typing test - offline desktop build (Tauri)"
arch=(x86_64)
url="https://monkeytype.com"
license=(GPL-3.0-only)
depends=(
  'gtk3'
  'webkit2gtk-4.1'
  'hicolor-icon-theme'
  'libayatana-appindicator'
)
makedepends=(
  'nodejs'
  'pnpm'
  'rust'
  'clang'
  'pkg-config'
  'glib2'
  'gtk3'
  'webkit2gtk-4.1'
  'openssl'
)
source=("$pkgname-$pkgver.tar.gz"
        "paralleltype-desktop.desktop") # snapshot of the repo root + desktop entry
sha256sums=('SKIP'
            'SKIP')               # fill with makepkg -g when packaging a release tarball
options=(!strip)

# the frontend build bakes the offline configuration; the binary identifies
# as com.monkeytype.desktop and shares no state with the website.
# engine-strict is disabled: Arch ships the current nodejs, while the
# upstream engines field pins a narrower range that upstream CI uses.
prepare() {
  cd "$srcdir"
  pnpm install --config.engine-strict=false
}

build() {
  cd "$srcdir/frontend"
  env \
    RECAPTCHA_SITE_KEY=offline-build \
    BACKEND_URL=http://127.0.0.1:9 \
    NODE_OPTIONS=--dns-result-order=ipv4first \
    ./node_modules/.bin/vite build

  cd src-tauri
  env NODE_OPTIONS=--dns-result-order=ipv4first cargo build --release
}

package() {
  cd "$srcdir/frontend/src-tauri"

  install -Dm755 target/release/paralleltype \
    "$pkgdir/usr/bin/paralleltype-desktop"

  # application icon (generated by `tauri icon` in src-tauri/icons)
  install -Dm644 icons/32x32.png \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/paralleltype-desktop.png"
  install -Dm644 icons/128x128.png \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/paralleltype-desktop.png"
  install -Dm644 icons/128x128@2x.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/paralleltype-desktop.png"
  install -Dm644 icons/icon.png \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/paralleltype-desktop.png"

  # desktop entry
  install -Dm644 "$srcdir/paralleltype-desktop.desktop" \
    "$pkgdir/usr/share/applications/paralleltype-desktop.desktop"

  # GPL-3.0 requires the license text to accompany the package
  install -Dm644 "$srcdir/LICENSE" \
    "$pkgdir/usr/share/licenses/paralleltype-desktop/LICENSE"
}
