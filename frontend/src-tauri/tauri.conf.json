{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monkeytype",
  "version": "0.4.0",
  "identifier": "com.monkeytype.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
