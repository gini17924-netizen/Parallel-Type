{
  "extends": "@monkeytype/typescript-config/base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "allowUmdGlobalAccess": true,
    "target": "ES6",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "paths": {
      "@keybr/lang": ["./src/keybr/@keybr/lang/lib/*"],
      "@keybr/math": ["./src/keybr/@keybr/math/lib/*"],
      "@keybr/rand": ["./src/keybr/@keybr/rand/lib/*"],
      "@keybr/unicode": ["./src/keybr/@keybr/unicode/lib/*"],
      "@keybr/keyboard": ["./src/keybr/@keybr/keyboard/lib/*"],
      "@keybr/phonetic-model": ["./src/keybr/@keybr/phonetic-model/lib/*"],
      "@keybr/lesson": ["./src/keybr/@keybr/lesson/lib/*"],
      "@keybr/content": ["./src/keybr/@keybr/content/lib/*"],
      "@keybr/content-words": ["./src/keybr/@keybr/content-words/lib/*"],
      "@keybr/result": ["./src/keybr/@keybr/result/lib/*"],
      "@keybr/settings": ["./src/keybr/@keybr/settings/lib/*"],
      "@keybr/textinput": ["./src/keybr/@keybr/textinput/lib/*"],
      "@keybr/textinput-events": ["./src/keybr/@keybr/textinput-events/lib/*"],
      "@keybr/code": ["./src/keybr/@keybr/code/lib/*"],
      "@keybr/binary": ["./src/keybr/@keybr/binary/lib/*"],
      "@keybr/themes": ["./src/keybr/@keybr/themes/lib/*"],
      "@keybr/widget": ["./src/keybr/@keybr/widget/lib/*"],
      "@keybr/practice-state": ["./src/keybr/@keybr/practice-state/*"],
      "virtual:language-hashes": [
        "./src/ts/types/virtual-language-hashes.d.ts"
      ],
      "virtual:env-config": ["./src/ts/types/virtual-env-config.d.ts"]
    }
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "./scripts/**/*.ts",
    "vite-plugins/**/*.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "build", "setup-tests.ts", "./__tests__/**/*.*"]
}
