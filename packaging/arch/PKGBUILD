# Maintainer: shahab <local>
# Monkeytype Desktop - offline Tauri build of monkeytype (desktop fork 0.4.0)
#
# STATUS: prepared on Windows, NOT yet validated on a real Arch system.
# Validate with `makepkg -si` on Arch before distributing (backlog B13).

pkgname=paralleltype-desktop
pkgver=0.5.0
pkgrel=1
pkgdesc="A minimalistic, customizable typing test - offline desktop build (Tauri)"
arch=(x86_64)
url="https://monkeytype.com"
license=(GPL-3.0-only)
depends=(
  'gtk3'
  'webkit2gtk-4.1'
  'hicolor-icon-theme'
)
makedepends=(
  'nodejs-lts-jod'
  'pnpm'
  'rust'
  'clang'
  'pkg-config'
  'glib2'
  'gtk3'
  'webkit2gtk-4.1'
  'openssl'
)
source=("$pkgname-$pkgver.tar.gz") # snapshot of the repo root
sha256sums=('SKIP')               # fill with makepkg -g when packaging a release tarball
options=(!strip)

# the frontend build bakes the offline configuration; the binary identifies
# as com.monkeytype.desktop and shares no state with the website
prepare() {
  cd "$srcdir"
  pnpm install
}

build() {
  cd "$srcdir/frontend"
  env \
    RECAPTCHA_SITE_KEY=offline-build \
    BACKEND_URL=http://127.0.0.1:9 \
    NODE_OPTIONS=--dns-result-order=ipv4first \
    ./node_modules/.bin/vite build

  cd src-tauri
  env NODE_OPTIONS=--dns-result-order=ipv4first cargo build --release
}

package() {
  cd "$srcdir/frontend/src-tauri"

  install -Dm755 target/release/paralleltype \
    "$pkgdir/usr/bin/monkeytype-desktop"

  # application icon (generated by `tauri icon` in src-tauri/icons)
  for size in 32x32 128x128 256x256; do
    install -Dm644 "icons/${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}/apps/paralleltype-desktop.png" ||
      true
  done
  install -Dm644 icons/icon.png \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/paralleltype-desktop.png" || true

  # desktop entry
  install -Dm644 "$srcdir/monkeytype-desktop.desktop" \
    "$pkgdir/usr/share/applications/monkeytype-desktop.desktop"
}
