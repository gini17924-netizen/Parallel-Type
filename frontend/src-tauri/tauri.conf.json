{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ParallelType",
  "version": "0.20.0",
  "identifier": "com.monkeytype.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://updates.paralleltype.example/updates.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFNzkyNjFDRUVCMkVDREMKUldUYzdMTHVIQ1o1YmlOdHBCd1p4clFRWjlTS01tSjFMdUtOUjRNd2ZMOEV4Y3l3SzBrYmZJTHcK"
    }
  }
}
